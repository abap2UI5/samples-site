---
/* The document around every page: head, the top line, the foot - after
 * CONVENTION.md in abap2UI5/abap2UI5.github.io, copied, not imported.
 *
 * THE POLICY. GitHub Pages sets no headers of ours, so the Content-Security-
 * Policy is a <meta>. The only script is public/filter.js on the catalogue,
 * a file of this origin; no inline script, no handler attribute, nothing
 * loaded from another origin. test/site.test.mjs holds every page to it. */
import "../styles/global.css";

/* `trail`: where a sample page sits under Samples - its repository and its
 * group - written after the Samples tab, so the top line is the way back. */
interface Props { title: string; description: string; trail?: { text: string; href?: string }[] }
const { title, description, trail = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const CSP = ["default-src 'self'", "script-src 'self'", "style-src 'self'", "img-src 'self'", "font-src 'self'", "object-src 'none'", "base-uri 'self'", "form-action 'none'"].join("; ");
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content={CSP}>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<link rel="icon" href={`${base}favicon.png`}>
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
</head>
<body>
<div class="topline wrap">
  <nav class="sites" aria-label="Breadcrumb">
    <a class="brand" href="https://abap2ui5.github.io/"><img src={`${base}logo.png`} alt="" width="22" height="22"> abap2UI5</a>
    <a href="https://abap2ui5.github.io/">Home</a>
    <span class="sep" aria-hidden="true">/</span>
    {trail.length ? <a href={base}>Samples</a> : <span aria-current="page">Samples</span>}
    {trail.map((t, i) => <><span class="sep" aria-hidden="true">/</span>{i === trail.length - 1 ? <span aria-current="page">{t.text}</span> : t.href ? <a href={t.href}>{t.text}</a> : <span>{t.text}</span>}</>)}
  </nav>
</div>
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap">
    <div class="foot-row"><span><a href="https://abap2ui5.github.io/">abap2UI5</a> · MIT licensed · <a href="https://github.com/abap2UI5/samples-site">Edit this page</a></span><a class="mail" href="mailto:contact@abap2UI5.org" aria-label="Mail contact@abap2UI5.org" title="contact@abap2UI5.org"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.6 6.6 8.4 6.6 8.4-6.6"/></svg></a></div>
  </div>
</footer>
</body>
</html>
