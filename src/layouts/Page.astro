---
/* The document around every page: head, the top line, the foot - after
 * CONVENTION.md in abap2UI5/abap2UI5.github.io, copied, not imported.
 *
 * THE POLICY. GitHub Pages sets no headers of ours, so the Content-Security-
 * Policy is a <meta>. The only script is public/filter.js on the catalogue,
 * a file of this origin; no inline script, no handler attribute, nothing
 * loaded from another origin. test/site.test.mjs holds every page to it. */
import "../styles/global.css";
import { latestRelease } from "../data/release";
const release = await latestRelease();

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const CSP = ["default-src 'self'", "script-src 'self'", "style-src 'self'", "img-src 'self'", "font-src 'self'", "object-src 'none'", "base-uri 'self'", "form-action 'none'"].join("; ");
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content={CSP}>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<link rel="icon" href={`${base}favicon.png`}>
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
</head>
<body>
<div class="topline wrap">
  <nav class="sites" aria-label="Sites">
    <a class="brand" href="https://abap2ui5.github.io/"><img src={`${base}logo.png`} alt="" width="22" height="22"> abap2UI5</a>
    <a href="https://abap2ui5.github.io/">Home</a>
    <a href={base} aria-current="page">Samples</a>
  </nav>
</div>
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap">
    <div class="foot-row">
      <span>abap2UI5 · open source since 2023 · MIT licensed{release && <> · <a href={`https://github.com/abap2UI5/abap2UI5/releases/tag/${release}`}>release {release}</a></>}</span>
      <span>No cookies, no tracking · <a href="mailto:contact@abap2UI5.org">contact@abap2UI5.org</a> · <a href="https://abap2ui5.github.io/">Home</a> · <a href="https://github.com/abap2UI5/samples-site">Edit this page</a></span>
    </div>
  </div>
</footer>
</body>
</html>
