---
/* The catalogue: every sample of the three sample repositories, grouped by
 * repository and then by stage, library or technology. Above them a search -
 * words, repository, UI5 library, the release your system runs, "runs in the
 * browser" - which public/filter.js runs; without the script the form stays
 * hidden and every sample is shown. */
import Page from "../layouts/Page.astro";
import Tile from "../components/Tile.astro";
import { samples, sources, libraries, releases, groupsOf } from "../data/catalogue";
const base = import.meta.env.BASE_URL;
---
<Page title="abap2UI5 samples" description={`Every abap2UI5 sample in one place - ${samples.length} ready-to-run apps, searchable by what they do, by control, library and the UI5 release your system runs.`}>
<div class="wrap">
  <h1 class="welcome">Samples</h1>

  <form class="finder" role="search" hidden>
    <input class="finder-q" id="finder-q" type="search" placeholder="Search title, summary, control, class..." aria-label="Search" autocomplete="off">
    <div class="finder-row">
      <label>Repository
        <select name="source"><option value="">all three</option>{sources.map((s) => <option value={s.id}>{s.title}</option>)}</select>
      </label>
      <label>Library
        <select name="lib"><option value="">any library</option>{libraries.map((l) => <option value={l}>{l}</option>)}</select>
      </label>
      <label>Runs on UI5
        <select name="ui5"><option value="">any release</option>{releases.map((r) => <option value={r}>{r}</option>)}</select>
      </label>
      <label><input type="checkbox" name="runs"> Runs in the browser</label>
      <p class="finder-count" aria-live="polite"><strong class="finder-shown">{samples.length}</strong> of {samples.length} samples</p>
    </div>
    <p class="finder-empty" hidden>Nothing matches. <button type="reset" class="finder-reset">Clear the search</button></p>
  </form>

  {sources.map((src) => (
    <section class="source" id={src.id} data-source-section={src.id}>
      <div class="source-head">
        <h2>{src.title}</h2>
        <p>{src.blurb} <a href={`https://github.com/${src.repo}`} target="_blank" rel="noopener">{src.repo} ↗</a></p>
      </div>
      {groupsOf(src.id).map((g) => (
        <section class="group" id={g.id}>
          <h2>{g.title}</h2>
          {g.blurb && <p class="lead">{g.blurb}</p>}
          <ul class="tiles">{g.items.map((s) => <Tile s={s} />)}</ul>
        </section>
      ))}
    </section>
  ))}
</div>
<script is:inline src={`${base}filter.js`} defer></script>
</Page>
